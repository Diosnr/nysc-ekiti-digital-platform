// NYSC Ekiti Digital Platform — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  phone            String?
  gradeLevel       String?
  rank             String?
  post             String?
  lgaCode          String?
  zoneCode         String?
  platoonCode      String?
  /** Officer signature image */
  signatureUrl     String?
  isActive         Boolean   @default(true)
  activationToken  String?
  activationSentAt DateTime?
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles                     UserRole[]
  auditLogs                 AuditLog[]              @relation("AuditActor")
  refreshTokens             RefreshToken[]
  pcmsCreated               Pcm[]                   @relation("PcmCreatedBy")
  platoonTenures            PlatoonOfficerTenure[]
  newsAuthored              NewsArticle[]           @relation("NewsAuthor")
  announcementsAuthored     Announcement[]          @relation("AnnouncementAuthor")
  electronicFilesOpened     ElectronicFile[]        @relation("FileOpenedBy")
  minutesAuthored           MinuteSheet[]           @relation("MinuteFrom")

  @@index([lgaCode])
  @@index([zoneCode])
  @@index([platoonCode])
  @@index([isActive])
}

model PlatoonOfficerTenure {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platoonCode    String
  officerName    String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  assignedById   String?
  assignedByName String?
  note           String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([platoonCode])
  @@index([startedAt])
  @@index([endedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  scopeJson  String?
  assignedAt DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id              String   @id @default(cuid())
  actorId         String?
  actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail      String?
  actorRoleAtTime String?
  action          String
  entityType      String?
  entityId        String?
  pcmId           String?
  beforeJson      String?
  afterJson       String?
  ip              String?
  userAgent       String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([pcmId])
  @@index([action])
  @@index([createdAt])
}

enum PcmLifecycleStatus {
  MOBILISED
  VERIFIED
  CHECKED_IN
  CHECKED_OUT
  ACCOMMODATED
  REGISTERED
  BANK_REGISTERED
  PLATOON_ASSIGNED
  KIT_ISSUED
  CAMP_ACTIVE
  CAMP_EXIT_REQUESTED
  CAMP_EXITED
  PPA_POSTED
  CLEARED
  COMPLETED
}

enum CampExitGround {
  MARITAL
  MEDICAL
  TERRORISM
}

enum CampExitStage {
  AWAITING_CLINIC
  AWAITING_CAMP_DIRECTOR
  AWAITING_STATE_COORDINATOR
  APPROVED
  REJECTED
  CANCELLED
}

enum HostelGender {
  MALE
  FEMALE
  MIXED
}

enum BedStatus {
  VACANT
  OCCUPIED
  BLOCKED
}

enum ClinicEncounterStatus {
  OPEN
  CLOSED
}

model Hostel {
  id                String        @id @default(cuid())
  name              String
  genderRestriction HostelGender  @default(MIXED)
  capacity          Int
  isActive          Boolean       @default(true)
  notes             String?
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  beds Bed[]

  @@index([isActive])
  @@index([genderRestriction])
  @@index([sortOrder])
}

model Bed {
  id               String    @id @default(cuid())
  hostelId         String
  hostel           Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  code             String
  status           BedStatus @default(VACANT)
  currentPcmId     String?   @unique
  currentPcm       Pcm?      @relation(fields: [currentPcmId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?
  assignedById     String?
  assignedByName   String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([hostelId, code])
  @@index([hostelId])
  @@index([status])
  @@index([currentPcmId])
}

model Pcm {
  id                    String             @id @default(cuid())
  callUpNumber          String             @unique
  fullName              String
  gender                String?
  dateOfBirth           DateTime?
  institution           String?
  course                String?
  phone                 String?
  email                 String?
  photographUrl         String?
  deploymentState       String?
  stateCode             String?
  campAddress           String?
  dateReporting         String?
  batchYear             String?
  stream                String?
  originState           String?
  lgaCode               String?
  zoneCode              String?
  status                PcmLifecycleStatus @default(VERIFIED)
  campExitGrantedAt     DateTime?
  campExitGrantedById   String?
  exitGround            String?
  exitReason            String?
  exitDestinationState  String?
  exitDestinationLga    String?
  expectedReturnAt      DateTime?
  checkedOutAt          DateTime?
  ppaName               String?
  ppaAddress            String?
  lgiName               String?
  lgiPhone              String?
  ziName                String?
  ziPhone               String?
  platoonCode           String?
  platoonAssignedAt     DateTime?
  platoonAssignedByName String?
  kitIssuedAt           DateTime?
  kitIssuedByName       String?
  kitItemsJson          String?
  notes                 String?
  createdById           String?
  createdBy             User?              @relation("PcmCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  verifications    VerificationRecord[]
  familyStatuses   PcmFamilyStatus[]
  skillProfiles    PcmSkillProfile[]
  ninRecords       PcmNinRecord[]
  bankRegistration PcmBankRegistration?
  exitRequests     CampExitRequest[]
  attendance       PlatoonAttendance[]
  electronicFiles  ElectronicFile[]
  bed              Bed?
  clinicEncounters ClinicEncounter[]

  @@index([fullName])
  @@index([stateCode])
  @@index([deploymentState])
  @@index([lgaCode])
  @@index([zoneCode])
  @@index([status])
  @@index([batchYear])
  @@index([campExitGrantedAt])
  @@index([checkedOutAt])
  @@index([platoonCode])
  @@index([kitIssuedAt])
}

/// Bank / account desk — sensitive. Staff record bank details; never auto-generate account numbers.
model PcmBankRegistration {
  id              String   @id @default(cuid())
  pcmId           String   @unique
  pcm             Pcm      @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  bankName        String?
  accountNumber   String?
  accountName     String?
  bvn             String?
  note            String?
  registeredById  String?
  registeredByName String?
  registeredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bankName])
  @@index([accountNumber])
  @@index([registeredAt])
}

/// Classified clinical record — access restricted to camp:clinic holders only.
model ClinicEncounter {
  id                 String                 @id @default(cuid())
  pcmId              String
  pcm                Pcm                    @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  status             ClinicEncounterStatus  @default(OPEN)
  chiefComplaint     String?
  diagnosis          String?
  doctorNote         String?
  openedById         String?
  openedByName       String?
  openedAt           DateTime               @default(now())
  attendedByDoctorId String?
  attendedByDoctorName String?
  attendedAt         DateTime?
  closedById         String?
  closedByName       String?
  closedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  vitals ClinicVital[]
  drugs  ClinicDrugDispense[]

  @@index([pcmId])
  @@index([status])
  @@index([openedAt])
}

model ClinicVital {
  id               String          @id @default(cuid())
  encounterId      String
  encounter        ClinicEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  recordedById     String?
  recordedByName   String?
  bpSystolic       Int?
  bpDiastolic      Int?
  pulse            Int?
  temperatureC     Float?
  respiratoryRate  Int?
  weightKg         Float?
  spo2             Int?
  note             String?
  recordedAt       DateTime        @default(now())

  @@index([encounterId])
  @@index([recordedAt])
}

model ClinicDrugDispense {
  id               String          @id @default(cuid())
  encounterId      String
  encounter        ClinicEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  drugName         String
  dose             String?
  quantity         String?
  instructions     String?
  dispensedById    String?
  dispensedByName  String?
  dispensedAt      DateTime        @default(now())

  @@index([encounterId])
  @@index([dispensedAt])
}

model PlatoonAttendance {
  id             String   @id @default(cuid())
  pcmId          String
  pcm            Pcm      @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  present        Boolean  @default(true)
  recordedById   String?
  recordedByName String?
  note           String?
  createdAt      DateTime @default(now())

  @@unique([pcmId, date])
  @@index([date])
  @@index([pcmId])
}

model CampExitRequest {
  id                String         @id @default(cuid())
  pcmId             String
  pcm               Pcm            @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  ground            CampExitGround
  reasonDetail      String?
  photoUrlsJson     String?
  stage             CampExitStage
  initiatedById     String
  initiatedByName   String
  initiatedAt       DateTime       @default(now())
  nextAssigneeId    String?
  nextAssigneeName  String?
  clinicById        String?
  clinicByName      String?
  clinicAt          DateTime?
  clinicNote        String?
  directorById      String?
  directorByName    String?
  directorAt        DateTime?
  directorNote      String?
  coordinatorById   String?
  coordinatorByName String?
  coordinatorAt     DateTime?
  coordinatorNote   String?
  rejectedById      String?
  rejectedByName    String?
  rejectedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([pcmId])
  @@index([stage])
  @@index([ground])
  @@index([initiatedAt])
  @@index([nextAssigneeId])
}

model VerificationRecord {
  id         String   @id @default(cuid())
  pcmId      String
  pcm        Pcm      @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  source     String
  inputRef   String?
  rawJson    String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([pcmId])
  @@index([verifiedAt])
}

model PcmFamilyStatus {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  statusesJson String
  husbandName  String?
  address      String
  state        String?
  lga          String?
  community    String?
  phone        String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model PcmSkillProfile {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  skill1       String?
  skill2       String?
  skill3       String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model PcmNinRecord {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  nin          String?
  frontUrl     String?
  backUrl      String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model CampAddress {
  id        String   @id @default(cuid())
  name      String
  address   String
  state     String?
  lga       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@index([sortOrder])
}

model Community {
  id        String   @id @default(cuid())
  name      String
  lga       String?
  state     String?  @default("Ekiti")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@index([lga])
  @@index([name])
}

model RegistrationImportJob {
  id            String   @id @default(cuid())
  startedById   String?
  startedByName String?
  fileName      String?
  totalRows     Int      @default(0)
  processed     Int      @default(0)
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  status        String   @default("RUNNING")
  errorSample   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  excerpt     String?
  body        String
  imageUrl    String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  authorId    String?
  author      User?     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  authorId    String?
  author      User?     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model ExitGroundOption {
  id             String   @id @default(cuid())
  code           String   @unique
  label          String
  requiresClinic Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum ElectronicFileType {
  CAMP_EXIT
  LEAVE
  SICK_LEAVE
  CASUAL_LEAVE
  MATERNITY_LEAVE
  CONVOCATION_LEAVE
  RELOCATION
  REPOSTING
  GENERAL
  QUERY
  OTHERS
}

enum ElectronicFileStatus {
  DRAFT
  IN_TRANSIT
  PENDING
  APPROVED
  RETURNED
  REJECTED
  CLOSED
}

enum MinuteAction {
  DRAFT
  FORWARD
  RETURN
  REJECT
  RECOMMEND
  APPROVE
}

model ElectronicFile {
  id                 String               @id @default(cuid())
  pcmId              String
  pcm                Pcm                  @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  type               ElectronicFileType   @default(GENERAL)
  subject            String
  priority           String               @default("NORMAL")
  status             ElectronicFileStatus @default(DRAFT)
  groundCode         String?
  exitRequestId      String?
  openedById         String?
  openedBy           User?                @relation("FileOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedByName       String?
  currentHolderId    String?
  currentHolderName  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  minutes MinuteSheet[]

  @@index([pcmId])
  @@index([type])
  @@index([status])
  @@index([currentHolderId])
  @@index([exitRequestId])
  @@index([createdAt])
}

model MinuteSheet {
  id                 String       @id @default(cuid())
  fileId             String
  file               ElectronicFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fromUserId         String?
  fromUser           User?        @relation("MinuteFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromName           String
  toUserId           String?
  toName             String?
  ccJson             String?
  body               String
  action             MinuteAction @default(FORWARD)
  attachmentUrlsJson String?
  includePcmProfile  Boolean      @default(false)
  createdAt          DateTime     @default(now())

  @@index([fileId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}
