// NYSC Ekiti Digital Platform — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  phone            String?
  gradeLevel       String?
  rank             String?
  post             String?
  lgaCode          String?
  zoneCode         String?
  isActive         Boolean   @default(true)
  activationToken  String?
  activationSentAt DateTime?
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles         UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  refreshTokens RefreshToken[]
  pcmsCreated   Pcm[]          @relation("PcmCreatedBy")

  @@index([lgaCode])
  @@index([zoneCode])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  scopeJson  String?
  assignedAt DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id              String   @id @default(cuid())
  actorId         String?
  actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail      String?
  actorRoleAtTime String?
  action          String
  entityType      String?
  entityId        String?
  pcmId           String?
  beforeJson      String?
  afterJson       String?
  ip              String?
  userAgent       String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([pcmId])
  @@index([action])
  @@index([createdAt])
}

enum PcmLifecycleStatus {
  MOBILISED
  VERIFIED
  CHECKED_IN
  CHECKED_OUT
  ACCOMMODATED
  REGISTERED
  BANK_REGISTERED
  PLATOON_ASSIGNED
  KIT_ISSUED
  CAMP_ACTIVE
  CAMP_EXIT_REQUESTED
  CAMP_EXITED
  PPA_POSTED
  CLEARED
  COMPLETED
}

// Grounds for leaving camp early
enum CampExitGround {
  MARITAL
  MEDICAL
  TERRORISM
}

// Workflow stage awaiting the next approver
enum CampExitStage {
  AWAITING_CLINIC
  AWAITING_CAMP_DIRECTOR
  AWAITING_STATE_COORDINATOR
  APPROVED
  REJECTED
  CANCELLED
}

model Pcm {
  id                    String             @id @default(cuid())
  callUpNumber          String             @unique
  fullName              String
  gender                String?
  dateOfBirth           DateTime?
  institution           String?
  course                String?
  phone                 String?
  email                 String?
  photographUrl         String?
  deploymentState       String?
  stateCode             String?
  campAddress           String?
  dateReporting         String?
  batchYear             String?
  stream                String?
  originState           String?
  lgaCode               String?
  zoneCode              String?
  status                PcmLifecycleStatus @default(VERIFIED)
  campExitGrantedAt     DateTime?
  campExitGrantedById   String?
  // Latest exit ground stamped on profile
  exitGround            String?
  exitReason            String?
  exitDestinationState  String?
  checkedOutAt          DateTime?
  ppaName               String?
  ppaAddress            String?
  lgiName               String?
  lgiPhone              String?
  ziName                String?
  ziPhone               String?
  notes                 String?
  createdById           String?
  createdBy             User?              @relation("PcmCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  verifications   VerificationRecord[]
  familyStatuses  PcmFamilyStatus[]
  skillProfiles   PcmSkillProfile[]
  ninRecords      PcmNinRecord[]
  exitRequests    CampExitRequest[]

  @@index([fullName])
  @@index([stateCode])
  @@index([deploymentState])
  @@index([lgaCode])
  @@index([zoneCode])
  @@index([status])
  @@index([batchYear])
  @@index([campExitGrantedAt])
  @@index([checkedOutAt])
}

// Camp exit: Platoon initiates -> Clinic if MEDICAL -> Camp Director -> State Coordinator.
// Approvals stamp the person's real name, not only role.
model CampExitRequest {
  id              String         @id @default(cuid())
  pcmId           String
  pcm             Pcm            @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  ground          CampExitGround
  reasonDetail    String?
  photoUrlsJson   String?
  stage           CampExitStage
  // Initiator (platoon officer)
  initiatedById   String
  initiatedByName String
  initiatedAt     DateTime       @default(now())
  // Clinic (medical path only)
  clinicById      String?
  clinicByName    String?
  clinicAt        DateTime?
  clinicNote      String?
  // Camp Director
  directorById    String?
  directorByName  String?
  directorAt      DateTime?
  directorNote    String?
  // State Coordinator (final)
  coordinatorById   String?
  coordinatorByName String?
  coordinatorAt     DateTime?
  coordinatorNote   String?
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([pcmId])
  @@index([stage])
  @@index([ground])
  @@index([initiatedAt])
}

model VerificationRecord {
  id         String   @id @default(cuid())
  pcmId      String
  pcm        Pcm      @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  source     String
  inputRef   String?
  rawJson    String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([pcmId])
  @@index([verifiedAt])
}

model PcmFamilyStatus {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  statusesJson String
  husbandName  String?
  address      String
  state        String?
  lga          String?
  community    String?
  phone        String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model PcmSkillProfile {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  skill1       String?
  skill2       String?
  skill3       String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model PcmNinRecord {
  id           String   @id @default(cuid())
  pcmId        String?
  pcm          Pcm?     @relation(fields: [pcmId], references: [id], onDelete: SetNull)
  callUpNumber String
  fullName     String
  nin          String?
  frontUrl     String?
  backUrl      String?
  createdAt    DateTime @default(now())

  @@index([callUpNumber])
  @@index([pcmId])
}

model CampAddress {
  id        String   @id @default(cuid())
  name      String
  address   String
  state     String?
  lga       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@index([sortOrder])
}

model Community {
  id        String   @id @default(cuid())
  name      String
  lga       String?
  state     String?  @default("Ekiti")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@index([lga])
  @@index([name])
}
