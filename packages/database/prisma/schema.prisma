// NYSC Ekiti Digital Platform — Prisma Schema (Phase 0 foundation)
// Detailed models will be expanded in Phases 2–4.
// PCM remains the central aggregate root.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder models — expanded in later phases.
// Do not treat these as final.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to be expanded: roles, audit events, etc.
}

// Further models (Pcm, Role, Permission, Hostel, Bed, AuditLog, etc.)
// will be introduced with proper relations when Phase 2–4 begins.
