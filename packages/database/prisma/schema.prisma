// NYSC Ekiti Digital Platform — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  phone            String?
  gradeLevel       String?
  rank             String?
  post             String?
  lgaCode          String?
  zoneCode         String?
  isActive         Boolean   @default(true)
  activationToken  String?
  activationSentAt DateTime?
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles         UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  refreshTokens RefreshToken[]
  pcmsCreated   Pcm[]          @relation("PcmCreatedBy")

  @@index([lgaCode])
  @@index([zoneCode])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  scopeJson  String?
  assignedAt DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id              String   @id @default(cuid())
  actorId         String?
  actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail      String?
  actorRoleAtTime String?
  action          String
  entityType      String?
  entityId        String?
  pcmId           String?
  beforeJson      String?
  afterJson       String?
  ip              String?
  userAgent       String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([pcmId])
  @@index([action])
  @@index([createdAt])
}

enum PcmLifecycleStatus {
  MOBILISED
  VERIFIED
  CHECKED_IN
  CHECKED_OUT
  ACCOMMODATED
  REGISTERED
  BANK_REGISTERED
  PLATOON_ASSIGNED
  KIT_ISSUED
  CAMP_ACTIVE
  CAMP_EXIT_REQUESTED
  CAMP_EXITED
  PPA_POSTED
  CLEARED
  COMPLETED
}

model Pcm {
  id              String             @id @default(cuid())
  callUpNumber    String             @unique
  fullName        String
  gender          String?
  dateOfBirth     DateTime?
  institution     String?
  course          String?
  phone           String?
  email           String?
  photographUrl   String?
  deploymentState String?
  stateCode       String?
  campAddress     String?
  dateReporting   String?
  batchYear       String?
  stream          String?
  originState     String?
  lgaCode         String?
  zoneCode        String?
  status          PcmLifecycleStatus @default(VERIFIED)
  notes           String?
  createdById     String?
  createdBy       User?              @relation("PcmCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  verifications VerificationRecord[]

  @@index([fullName])
  @@index([stateCode])
  @@index([deploymentState])
  @@index([lgaCode])
  @@index([zoneCode])
  @@index([status])
  @@index([batchYear])
}

model VerificationRecord {
  id         String   @id @default(cuid())
  pcmId      String
  pcm        Pcm      @relation(fields: [pcmId], references: [id], onDelete: Cascade)
  source     String
  inputRef   String?
  rawJson    String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([pcmId])
  @@index([verifiedAt])
}

model CampAddress {
  id        String   @id @default(cuid())
  name      String
  address   String
  state     String?
  lga       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@index([sortOrder])
}
