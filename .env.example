# Application
NODE_ENV=development
APP_NAME="NYSC Ekiti Digital Platform"
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://nysc:nysc@localhost:5432/nysc_ekiti?schema=public"

# Authentication (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed Super Admin (change password after first login)
SEED_SUPER_ADMIN_EMAIL=admin@nysc-ekiti.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMeNow!123

# Verification Adapter
VERIFICATION_ADAPTER=manual

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Logging
LOG_LEVEL=debug

# Feature Flags
FEATURE_PUBLIC_SITE=true
FEATURE_PCM_INTAKE=false
FEATURE_CAMP_OPERATIONS=false
FEATURE_FILE_MOVEMENT=false
