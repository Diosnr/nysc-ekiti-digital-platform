# Application
NODE_ENV=development
APP_NAME="NYSC Ekiti Digital Platform"
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://nysc:nysc@localhost:5432/nysc_ekiti?schema=public"

# Authentication
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Verification Adapter
# Options: manual | scraping | official_api
VERIFICATION_ADAPTER=manual
# SCRAPING / API credentials only if explicitly authorized
# NYSC_VERIFICATION_BASE_URL=
# NYSC_API_KEY=

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Logging
LOG_LEVEL=debug

# Feature Flags (examples)
FEATURE_PUBLIC_SITE=true
FEATURE_PCM_INTAKE=false
FEATURE_CAMP_OPERATIONS=false
