# Application
NODE_ENV=development
APP_NAME="NYSC Ekiti Digital Platform"
APP_URL=http://localhost:3000

# Database — local Docker or Neon/Railway connection string
DATABASE_URL="postgresql://nysc:nysc@localhost:5432/nysc_ekiti?schema=public"

# Auth (use long random strings in production / Vercel)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@nysc-ekiti.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMeNow!123

# Verification — NYSC CorpMemberVerify.aspx is always supported for QR URLs
VERIFICATION_ADAPTER=manual
VERIFICATION_ALLOW_REMOTE=false

# Storage / logging
STORAGE_DRIVER=local
LOG_LEVEL=debug
